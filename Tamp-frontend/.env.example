# Backend the /api/* reverse proxy forwards to — next.config.ts's rewrites()
# in dev/next-start, and frontend-proxy's nginx.conf.template in Docker.
# Server-side only; never exposed to the browser (no NEXT_PUBLIC_ prefix),
# since the frontend now always calls relative /api/ paths.
BACKEND_INTERNAL_URL=http://localhost:4000

# Host port nginx (frontend-proxy) publishes, when run via docker-compose.
FRONTEND_PORT=8080

# Baked into the image at build time — shown wherever the app displays its
# version.
NEXT_PUBLIC_APP_VERSION=dev
