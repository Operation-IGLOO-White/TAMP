// Prisma schema for TAMP. Models mirror the previous Drizzle tables 1:1
// (same table + column names) so existing Postgres data stays compatible.
// Nested domain fields (Place, Money, events, …) are stored as JSONB and typed
// on the app side in the tRPC routers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Party {
  id           String  @id
  role         String
  companyName  String  @map("company_name")
  contactName  String  @map("contact_name")
  email        String  @unique
  phone        String
  province     String
  verification String
  ratingAvg    Float?  @map("rating_avg")
  ratingCount  Int     @default(0) @map("rating_count")
  suspended    Boolean @default(false)
  avatarUrl    String? @map("avatar_url")
  kycDocument  Json?   @map("kyc_document")
  onboarding   Json?
  passwordHash String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  onboardingComplete Boolean @default(true) @map("onboarding_complete")
  createdAt    String    @map("created_at")

  sessions      Session[]
  oauthAccounts OAuthAccount[]

  @@map("parties")
}

// Links a third-party identity (Google, …) to a Party so repeat sign-ins map
// to one account. The same person's Google "sub" is stable across logins.
model OAuthAccount {
  id         String @id @default(cuid())
  provider   String
  providerId String @map("provider_id")
  partyId    String @map("party_id")
  createdAt  DateTime @default(now()) @map("created_at")
  party      Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

// Pending email-verification codes, keyed by email. One active code per email
// (upserted on resend). The code is stored hashed; account creation is gated on
// a server-side match here.
model EmailVerification {
  email     String   @id
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_verifications")
}

// Pending password-reset codes, keyed by the account email. Hashed, expiring.
model PasswordReset {
  email     String   @id
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_resets")
}

// Pending email-change requests, keyed by party. The code is emailed to the NEW
// address to prove ownership before the login email is switched.
model EmailChange {
  partyId   String   @id @map("party_id")
  newEmail  String   @map("new_email")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_changes")
}

model Session {
  id        String   @id
  partyId   String   @map("party_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ── Notifications ────────────────────────────────────────────────
// Per-user, written server-side on domain events (see server/events.ts). Read
// state lives per-row (readAt), replacing the old per-role "last read" stamp
// that was derived client-side from the audit log.
model Notification {
  id          String    @id
  partyId     String    @map("party_id")
  type        String
  title       String
  detail      String
  tone        String    @default("info")
  subjectType String?   @map("subject_type")
  subjectId   String?   @map("subject_id")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([partyId, createdAt])
  @@map("notifications")
}

// ── Outbound webhooks ────────────────────────────────────────────
// A party subscribes an HTTPS endpoint to domain events; the scheduler drains
// pending deliveries with an HMAC-signed POST and exponential backoff.
model WebhookEndpoint {
  id        String   @id
  partyId   String   @map("party_id")
  url       String
  secret    String
  events    Json // string[] of event types, or ["*"] for all
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([partyId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id            String   @id
  endpointId    String   @map("endpoint_id")
  event         String
  payload       Json
  status        String   @default("PENDING") // PENDING | SUCCESS | FAILED
  attempts      Int      @default(0)
  responseCode  Int?     @map("response_code")
  lastError     String?  @map("last_error")
  nextAttemptAt DateTime @map("next_attempt_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

// ── Uploaded files (local object store) ──────────────────────────
// Real bytes on disk under UPLOAD_DIR, served through an auth-gated route.
// Replaces the filename-only mocks for avatars, KYC, POD and truck photos.
model StoredFile {
  id          String   @id
  ownerId     String   @map("owner_id")
  kind        String // AVATAR | KYC | POD | TRUCK_PHOTO
  filename    String
  contentType String   @map("content_type")
  size        Int
  visibility  String   @default("private") // public | private
  path        String // relative path on disk
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([ownerId])
  @@map("stored_files")
}

// Domain entities persisted as whole-object JSON (pragmatic snapshot). The
// client store hydrates all of these on load and writes them back on change.
model Truck {
  id   String @id
  data Json

  @@map("trucks")
}

model Rating {
  id   String @id
  data Json

  @@map("ratings")
}

model Dispute {
  id   String @id
  data Json

  @@map("disputes")
}

model Acceptance {
  id   String @id
  data Json

  @@map("acceptances")
}

model Reservation {
  id   String @id
  data Json

  @@map("reservations")
}

model AuditEvent {
  id   String @id
  data Json

  @@map("audit_events")
}

model FuelLog {
  id   String @id
  data Json

  @@map("fuel_logs")
}

model MaintenanceTask {
  id   String @id
  data Json

  @@map("maintenance_tasks")
}

model Proof {
  id   String @id
  data Json

  @@map("proofs")
}

model Load {
  id                  String  @id
  ownerId             String  @map("owner_id")
  reference           String
  cargoType           String  @map("cargo_type")
  weightKg            Int     @map("weight_kg")
  volumeM3            Int?    @map("volume_m3")
  requiredBodyTypes   Json    @map("required_body_types")
  origin              Json
  destination         Json
  distanceKm          Int     @map("distance_km")
  pickupWindow        Json    @map("pickup_window")
  deliveryBy          String  @map("delivery_by")
  targetRate          Json?   @map("target_rate")
  specialRequirements String? @map("special_requirements")
  status              String
  createdAt           String  @map("created_at")

  @@map("loads")
}

model Match {
  id                       String  @id
  loadId                   String  @map("load_id")
  truckPostingId           String  @map("truck_posting_id")
  score                    Float
  breakdown                Json
  hardFilterResults        Json    @map("hard_filter_results")
  status                   String
  initiatedBy              String  @map("initiated_by")
  agreedRate               Json?   @map("agreed_rate")
  rejectionReason          String? @map("rejection_reason")
  confirmedByOwnerAt       String? @map("confirmed_by_owner_at")
  confirmedByTransporterAt String? @map("confirmed_by_transporter_at")
  expiresAt                String  @map("expires_at")
  createdAt                String  @map("created_at")

  @@map("matches")
}

model Trip {
  id                String  @id
  matchId           String  @map("match_id")
  status            String
  disputed          Boolean @default(false)
  events            Json
  simulatedPosition Json?   @map("simulated_position")
  progressPct       Float   @default(0) @map("progress_pct")
  etaAt             String? @map("eta_at")

  @@map("trips")
}
