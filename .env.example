FRONTEND_PORT=3000

# Public API path used by the browser bundle. Keep this relative when nginx proxies /api.
VITE_API_URL=/api/v1

# Backend origin used only by the local Vite development proxy.
VITE_API_TARGET=http://localhost:5000

# Docker nginx reaches the backend over the shared Compose network.
BACKEND_TARGET=http://backend:5000
# Must match TAMP_NETWORK in the backend Compose project.
TAMP_NETWORK=tamp-network

# Public frontend origin used in generated QR verification links.
VITE_FRONTEND_BASE_URL=http://localhost:3000
VITE_GIT_VERSION=dev

# Only needed for Vite dev server, not nginx production serving.
VITE_ALLOWED_HOSTS=localhost
